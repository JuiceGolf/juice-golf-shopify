{%- comment -%}
  Renders a team roster builder: multiple personalized players (name, number, size)
  added to the cart in one submit. Requires the product to have a "Size" option —
  other option types aren't supported. When enable_shirt_design is true, also
  requires a "Color" option and shows a shared color + logo design step above the
  roster rows.
  Usage: {% render 'roster-builder', product: product, name_label: ..., number_label: ..., add_label: ..., submit_label: ..., enable_shirt_design: ..., color_label: ..., logo_label: ... %}
{%- endcomment -%}

{%- liquid
  assign size_option = null
  assign color_option = null
  for option in product.options_with_values
    assign option_name_lower = option.name | downcase
    if option_name_lower == 'size'
      assign size_option = option
    endif
    if option_name_lower == 'color'
      assign color_option = option
    endif
  endfor
-%}

{%- if size_option == null -%}
  {%- if request.design_mode -%}
    <p class="text-muted">This product doesn't have a "Size" option, so the roster builder can't be shown here. Add a Size option to the product, or turn off "Enable team roster builder" in this section's settings.</p>
  {%- endif -%}
{%- elsif enable_shirt_design and color_option == null -%}
  {%- if request.design_mode -%}
    <p class="text-muted">Shirt design is enabled but this product doesn't have a "Color" option. Add a Color option to the product, or turn off "Enable shirt design" in this section's settings.</p>
  {%- endif -%}
{%- else -%}
  <roster-builder class="roster-builder" data-product-price="{{ product.price }}">
    <script type="application/json" data-roster-variants>{{ product.variants | json }}</script>

    <form action="{{ routes.cart_add_url }}" method="post" class="roster-builder__form" data-roster-form data-size-position="{{ size_option.position }}" {% if enable_shirt_design %}data-color-position="{{ color_option.position }}"{% endif %}>
      {%- if enable_shirt_design -%}
        {%- render 'shirt-designer', color_option: color_option, color_label: color_label, logo_label: logo_label -%}
      {%- endif -%}

      <div class="roster-builder__rows" data-roster-rows>
        {%- render 'roster-builder-row', size_option: size_option, name_label: name_label, number_label: number_label -%}
      </div>

      <template data-roster-row-template>
        {%- render 'roster-builder-row', size_option: size_option, name_label: name_label, number_label: number_label -%}
      </template>

      <button type="button" class="button button--ghost roster-builder__add" data-roster-add>
        {% render 'icon', name: 'plus' %}
        <span>{{ add_label }}</span>
      </button>

      <div class="roster-builder__footer">
        <div class="roster-builder__subtotal">
          <span>Subtotal</span>
          <span data-roster-subtotal>{{ product.price | money }}</span>
        </div>
        <button type="submit" class="button button--primary button--full" data-roster-submit>
          <span data-roster-submit-text>{{ submit_label }}</span>
        </button>
      </div>
    </form>
  </roster-builder>
{%- endif -%}
