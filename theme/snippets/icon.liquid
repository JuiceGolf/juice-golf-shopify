{%- comment -%}
  Renders an inline SVG icon.
  Usage: {% render 'icon', name: 'cart' %}
  Accepts: name (required), class (optional, extra classes)
{%- endcomment -%}

{%- liquid
  assign icon_class = 'icon'
  if class
    assign icon_class = icon_class | append: ' ' | append: class
  endif
-%}

{%- case name -%}
  {%- when 'menu' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round"/>
    </svg>
  {%- when 'close' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/>
    </svg>
  {%- when 'search' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <circle cx="10.5" cy="10.5" r="6.5"/>
      <path d="M20 20l-4.7-4.7" stroke-linecap="round"/>
    </svg>
  {%- when 'cart' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M5 8h14l-1.2 10.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 8Z" stroke-linejoin="round"/>
      <path d="M8.5 8V6.5a3.5 3.5 0 1 1 7 0V8" stroke-linecap="round"/>
    </svg>
  {%- when 'account' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <circle cx="12" cy="8.5" r="3.5"/>
      <path d="M4.5 20a7.5 7.5 0 0 1 15 0" stroke-linecap="round"/>
    </svg>
  {%- when 'chevron-down' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'chevron-right' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'arrow-right' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M4 12h16M14 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'check' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false">
      <path d="M5 12.5l5 5L19 7" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'minus' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M5 12h14" stroke-linecap="round"/>
    </svg>
  {%- when 'plus' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
    </svg>
  {%- when 'instagram' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/>
      <circle cx="12" cy="12" r="4"/>
      <circle cx="17" cy="7" r="1" fill="currentColor" stroke="none"/>
    </svg>
  {%- when 'facebook' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M14 21v-7h2.5l.5-3H14V9c0-.9.3-1.5 1.7-1.5H17V5c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.2V11H8v3h2.6v7H14Z"/>
    </svg>
  {%- when 'tiktok' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M14 4v10.5a3 3 0 1 1-2.2-2.9M14 4c.4 2 1.9 3.5 4 3.8" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'youtube' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <rect x="3.5" y="6" width="17" height="12" rx="3.5"/>
      <path d="M10.5 9.5l4.5 2.5-4.5 2.5v-5Z" fill="currentColor" stroke="none"/>
    </svg>
{%- endcase -%}
