{%- comment -%}
  Renders a newsletter signup form using Shopify's native customer form.
  Usage: {% render 'newsletter-form', id: 'FooterNewsletter' %}
{%- endcomment -%}

{%- form 'customer', id: id, class: 'newsletter-form' -%}
  <input type="hidden" name="contact[tags]" value="newsletter">

  <div class="newsletter-form__row">
    <div class="field" style="flex: 1;">
      <label class="visually-hidden" for="{{ id }}-email">{{ 'general.newsletter.placeholder' | t }}</label>
      <input
        type="email"
        name="contact[email]"
        id="{{ id }}-email"
        class="field__input"
        placeholder="{{ 'general.newsletter.placeholder' | t }}"
        autocomplete="email"
        required
      >
    </div>
    <button type="submit" class="button button--primary">{{ 'general.newsletter.submit' | t }}</button>
  </div>

  {%- if form.posted_successfully? -%}
    <p class="newsletter-form__message" role="status">{{ 'general.newsletter.success' | t }}</p>
  {%- elsif form.errors -%}
    <p class="newsletter-form__message newsletter-form__message--error" role="alert">{{ 'general.newsletter.error' | t }}</p>
  {%- endif -%}
{%- endform -%}
