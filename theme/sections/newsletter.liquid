<section class="section newsletter-section" data-section-id="{{ section.id }}">
  <div class="page-width newsletter-section__inner">
    <span class="eyebrow newsletter-section__eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 class="h0 newsletter-section__heading">{{ section.settings.heading }}</h2>

    {%- if section.settings.subtext != blank -%}
      <p class="text-muted newsletter-section__subtext">{{ section.settings.subtext }}</p>
    {%- endif -%}

    <div class="newsletter-section__form">
      {% render 'newsletter-form', id: 'HomepageNewsletter' %}
    </div>
  </div>
</section>

{% stylesheet %}
  .newsletter-section__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    padding-block: clamp(2.5rem, 2rem + 2vw, 4rem);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .newsletter-section__eyebrow {
    justify-content: center;
  }

  .newsletter-section__heading {
    max-width: 30rem;
  }

  .newsletter-section__subtext {
    max-width: 26rem;
  }

  .newsletter-section__form {
    width: 100%;
    max-width: 24rem;
    margin-top: 0.75rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Stay in the Loop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get Ready for Next Year's Trip"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "New gear drops, packing guides, and golf trip planning — straight to your inbox. No spam, just the good stuff before the trip."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
