<section class="section cart-page" data-section-id="{{ section.id }}">
  <div class="page-width">
    <h1 class="h1" style="margin-bottom: 2rem;">{{ 'general.cart.title' | t }}</h1>

    {%- if cart.item_count == 0 -%}
      <div class="cart-page__empty">
        <p class="text-muted">{{ 'general.cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="button button--primary">{{ 'general.cart.continue_shopping' | t }}</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" id="CartPageForm" class="cart-page__grid">
        <table class="cart-table">
          <thead>
            <tr>
              <th>Product</th>
              <th>{{ 'general.cart.quantity' | t }}</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr class="cart-table__row">
                <td class="cart-table__product">
                  <a href="{{ item.url }}" class="cart-table__image">
                    {%- if item.image -%}
                      <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" width="90" height="112" loading="lazy">
                    {%- endif -%}
                  </a>
                  <div>
                    <a href="{{ item.url }}" class="cart-table__title">{{ item.product.title }}</a>
                    {%- unless item.product.has_only_default_variant -%}
                      <p class="text-muted">{{ item.variant.title }}</p>
                    {%- endunless -%}
                    {%- if item.properties.size > 0 -%}
                      <dl class="cart-table__item-properties">
                        {%- for property in item.properties -%}
                          {%- liquid
                            assign property_key = property.first
                            assign property_value = property.last
                            assign key_prefix = property_key | slice: 0
                          -%}
                          {%- if key_prefix != '_' and property_value != blank -%}
                            <div class="cart-table__item-property">
                              <dt>{{ property_key }}:</dt>
                              <dd>{{ property_value }}</dd>
                            </div>
                          {%- endif -%}
                        {%- endfor -%}
                      </dl>
                    {%- endif -%}
                    <a href="{{ item.url_to_remove }}" class="link-underline" style="font-size: 0.8125rem;">{{ 'general.cart.remove' | t }}</a>
                  </div>
                </td>
                <td>
                  <input
                    type="number"
                    class="cart-qty-input"
                    name="updates[{{ item.key }}]"
                    value="{{ item.quantity }}"
                    min="0"
                    aria-label="{{ 'general.cart.quantity' | t }} — {{ item.product.title }}"
                  >
                </td>
                <td>{{ item.final_line_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <div class="cart-page__summary">
          {%- if settings.cart_show_shipping_note -%}
            <p class="text-muted">{{ settings.cart_shipping_note }}</p>
          {%- endif -%}

          <div class="cart-subtotal-row">
            <span>{{ 'general.cart.subtotal' | t }}</span>
            <span>{{ cart.total_price | money }}</span>
          </div>

          <div class="cart-actions-stack">
            <button type="submit" name="update" class="button button--secondary button--full">Update cart</button>
            <button type="submit" name="checkout" class="button button--primary button--full">{{ 'general.cart.checkout' | t }}</button>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .cart-page__empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .cart-page__grid {
    display: grid;
    grid-template-columns: 1fr 20rem;
    gap: 3rem;
    align-items: start;
  }

  @media screen and (max-width: 989px) {
    .cart-page__grid {
      grid-template-columns: 1fr;
    }
  }

  .cart-table {
    width: 100%;
    border-collapse: collapse;
  }

  .cart-table th {
    text-align: left;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .cart-table__row td {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }

  .cart-table__product {
    display: flex;
    gap: 1rem;
  }

  .cart-table__image img {
    border-radius: var(--input-radius);
    background: var(--color-background-alt);
    object-fit: cover;
  }

  .cart-table__title {
    font-weight: 600;
  }

  .cart-table__item-properties {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin: 0.15rem 0;
  }

  .cart-table__item-property {
    display: flex;
    gap: 0.35em;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .cart-table__item-property dt,
  .cart-table__item-property dd {
    margin: 0;
  }

  .cart-page__summary {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--color-background-alt);
    border-radius: var(--input-radius);
    position: sticky;
    top: 6rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart"
}
{% endschema %}
