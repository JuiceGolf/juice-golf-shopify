{%- comment -%}
  Destination photography mosaic. Uses bundled stock golf-course photography
  as a placeholder until real trip photos are uploaded. Location captions
  only render when a merchant explicitly fills one in, so a stock tile is
  never mislabeled as a specific real trip destination.
{%- endcomment -%}

<section class="section destination-photography" data-section-id="{{ section.id }}">
  <div class="page-width">
    {% render 'section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subtext: section.settings.subtext,
      align: 'left',
      row: true
    %}

    <div class="destination-photography__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          case forloop.index
            when 1
              assign stock_fallback = 'stock/destination-1-mountain.jpg'
            when 2
              assign stock_fallback = 'stock/destination-2-lake.jpg'
            when 3
              assign stock_fallback = 'stock/destination-3-aerial-lake.jpg'
            when 4
              assign stock_fallback = 'stock/destination-4-flag-field.jpg'
            else
              assign stock_fallback = 'stock/destination-5-flag-water.jpg'
          endcase
        -%}
        <div class="destination-photography__tile" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 900 }}"
              srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 900 }} 900w"
              sizes="(min-width: 750px) 30vw, 50vw"
              alt="{{ block.settings.image.alt | default: 'Juice Golf Trips destination photo' }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
            >
          {%- else -%}
            <img src="{{ stock_fallback | asset_url }}" alt="Golf course photography" loading="lazy">
            {%- if request.design_mode -%}
              <span class="destination-photography__stock-note">Stock photo</span>
            {%- endif -%}
          {%- endif -%}

          {%- if block.settings.image != blank and block.settings.location != blank -%}
            <span class="destination-photography__caption">{{ block.settings.location }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="destination-photography__cta">
        <a href="{{ section.settings.button_link | default: settings.social_instagram | default: '#' }}" class="link-underline">
          <span>{{ section.settings.button_label }}</span>
          {% render 'icon', name: 'arrow-right' %}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .destination-photography__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, minmax(11rem, 1fr));
    gap: var(--grid-gap);
  }

  .destination-photography__tile:nth-child(1) { grid-column: 1 / 3; grid-row: 1 / 2; }
  .destination-photography__tile:nth-child(2) { grid-column: 3 / 4; grid-row: 1 / 3; }
  .destination-photography__tile:nth-child(3) { grid-column: 4 / 5; grid-row: 1 / 3; }
  .destination-photography__tile:nth-child(4) { grid-column: 1 / 2; grid-row: 2 / 3; }
  .destination-photography__tile:nth-child(5) { grid-column: 2 / 3; grid-row: 2 / 3; }

  @media screen and (max-width: 989px) {
    .destination-photography__grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: none;
    }

    .destination-photography__tile:nth-child(1) { grid-column: span 2; grid-row: auto; aspect-ratio: 16 / 9; }
    .destination-photography__tile:nth-child(2),
    .destination-photography__tile:nth-child(3),
    .destination-photography__tile:nth-child(4),
    .destination-photography__tile:nth-child(5) { grid-column: span 1; grid-row: auto; aspect-ratio: 4 / 5; }
  }

  @media screen and (max-width: 599px) {
    .destination-photography__grid {
      grid-template-columns: 1fr;
    }

    .destination-photography__tile {
      grid-column: span 1 !important;
      aspect-ratio: 4 / 5 !important;
    }
  }

  .destination-photography__tile {
    position: relative;
    overflow: hidden;
    background: var(--color-background-alt);
  }

  .destination-photography__tile img,
  .destination-photography__tile .media-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .destination-photography__tile:hover img {
    transform: scale(1.045);
  }

  .destination-photography__stock-note {
    position: absolute;
    z-index: 1;
    top: 0.75rem;
    right: 0.75rem;
    padding: 0.2em 0.6em;
    background: color-mix(in srgb, var(--color-dark-background) 80%, transparent);
    color: var(--color-dark-text-muted);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .destination-photography__caption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.3em 0.7em;
    background: color-mix(in srgb, var(--color-dark-background) 78%, transparent);
    color: var(--color-dark-text);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .destination-photography__cta {
    margin-top: 2.5rem;
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Destination photography",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Where the Trip Takes You"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Destination Photography"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Sunrise tee times, matching jerseys, and the fairways worth flying for."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Footer link label",
      "default": "Follow the Trips on Instagram"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Footer link URL override",
      "info": "Leave blank to use the Instagram URL from Theme settings → Social media."
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location caption (optional)",
          "info": "Only shown if filled in — use a real trip destination, e.g. \"Bandon Dunes, OR.\""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Destination photography",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
