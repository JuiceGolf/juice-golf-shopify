<section class="section contact" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="contact__grid">
      <div class="stack" style="gap: 1rem;">
        <h1 class="h1">{{ section.settings.heading }}</h1>
        {%- if section.settings.text != blank -%}
          <div class="rte text-muted">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.email != blank -%}
          <a href="mailto:{{ section.settings.email }}" class="link-underline">{{ section.settings.email }}</a>
        {%- endif -%}
      </div>

      <div>
        {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="contact-form__success" role="status">Thanks — we'll be in touch shortly.</p>
          {%- endif -%}

          {%- if form.errors -%}
            <p class="newsletter-form__message newsletter-form__message--error" role="alert">
              Please check the form and try again.
            </p>
          {%- endif -%}

          <div class="field">
            <label for="ContactFormName">Name</label>
            <input type="text" id="ContactFormName" class="field__input" name="contact[name]" autocomplete="name">
          </div>

          <div class="field">
            <label for="ContactFormEmail">Email <span aria-hidden="true">*</span></label>
            <input
              type="email"
              id="ContactFormEmail"
              class="field__input"
              name="contact[email]"
              autocomplete="email"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              required
            >
          </div>

          <div class="field">
            <label for="ContactFormPhone">Phone</label>
            <input type="tel" id="ContactFormPhone" class="field__input" name="contact[phone]" autocomplete="tel">
          </div>

          <div class="field">
            <label for="ContactFormMessage">Message <span aria-hidden="true">*</span></label>
            <textarea id="ContactFormMessage" class="field__input" name="contact[body]" rows="5" required></textarea>
          </div>

          <button type="submit" class="button button--primary">Send message</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(2rem, 1.5rem + 2vw, 4rem);
    align-items: start;
  }

  @media screen and (max-width: 749px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .contact-form label {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.35rem;
    display: inline-block;
  }

  .contact-form textarea.field__input {
    resize: vertical;
  }

  .contact-form__success {
    padding: 0.85em 1em;
    background: var(--color-background-alt);
    border-radius: var(--input-radius);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in Touch"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Questions about a team order, timelines, or a custom design? Send a message and we'll get back to you.</p>"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Contact email (optional, shown on page)"
    }
  ]
}
{% endschema %}
