<section class="section section--alt team-packages" data-section-id="{{ section.id }}">
  <div class="page-width">
    {% render 'section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subtext: section.settings.subtext,
      align: 'center'
    %}

    <div class="team-packages__grid">
      {%- for block in section.blocks -%}
        <div class="package-card {% if block.settings.featured %}package-card--featured{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.featured -%}
            <span class="package-card__badge">{{ block.settings.badge_text | default: 'Most popular' }}</span>
          {%- endif -%}

          <h3 class="h3">{{ block.settings.title }}</h3>
          <p class="text-muted">{{ block.settings.description }}</p>

          {%- if block.settings.items != blank -%}
            <ul class="package-card__items">
              {%- assign item_list = block.settings.items | newline_to_br | strip_newlines | split: '<br />' -%}
              {%- for item in item_list -%}
                {%- if item != blank -%}
                  <li>
                    {% render 'icon', name: 'check' %}
                    <span>{{ item | strip }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <a
            href="{{ block.settings.button_link | default: '#' }}"
            class="button {% if block.settings.featured %}button--accent{% else %}button--primary{% endif %} button--full"
          >
            {{ block.settings.button_label }}
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .team-packages__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--grid-gap);
    align-items: stretch;
  }

  @media screen and (max-width: 989px) {
    .team-packages__grid {
      grid-template-columns: 1fr;
      max-width: 28rem;
      margin-inline: auto;
    }
  }

  .package-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 2rem;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--input-radius);
  }

  .package-card--featured {
    border-color: var(--color-primary);
    box-shadow: 0 20px 40px -24px rgba(0, 0, 0, 0.25);
  }

  .package-card__badge {
    position: absolute;
    top: -0.75rem;
    left: 2rem;
    padding: 0.3em 0.8em;
    background: var(--color-accent);
    color: var(--color-accent-text);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: var(--button-radius);
  }

  .package-card__items {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0.5rem 0 1rem;
  }

  .package-card__items li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.9rem;
  }

  .package-card__items .icon {
    width: 1rem;
    height: 1rem;
    margin-top: 0.15rem;
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .package-card .button {
    margin-top: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Team packages",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Team packages"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for Every Group Size"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Bundle jerseys, hats, and accessories for the whole crew."
    }
  ],
  "blocks": [
    {
      "type": "package",
      "name": "Package",
      "settings": [
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Highlight this package",
          "default": false
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text",
          "default": "Most popular"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The Foursome"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "For a tight group of 4."
        },
        {
          "type": "textarea",
          "id": "items",
          "label": "Included items (one per line)",
          "default": "4 custom jerseys\nMatching hats\nPersonalized names & numbers"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Start Designing"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Team packages",
      "blocks": [
        {
          "type": "package",
          "settings": {
            "title": "The Foursome",
            "description": "For a tight group of 4.",
            "items": "4 custom jerseys\nMatching hats\nPersonalized names & numbers"
          }
        },
        {
          "type": "package",
          "settings": {
            "featured": true,
            "title": "The Full Group",
            "description": "For groups of 8–12.",
            "items": "8–12 custom jerseys\nMatching hats & towels\nTeam name on every piece\nDivided into teams"
          }
        },
        {
          "type": "package",
          "settings": {
            "title": "Custom Trip",
            "description": "Larger groups or multiple teams.",
            "items": "Unlimited roster size\nFull apparel kit\nDedicated design review"
          }
        }
      ]
    }
  ]
}
{% endschema %}
