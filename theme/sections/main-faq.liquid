<section class="section faq" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="page__content">
      <h1 class="h1">{{ section.settings.heading }}</h1>
      {%- if section.settings.subtext != blank -%}
        <p class="text-muted">{{ section.settings.subtext }}</p>
      {%- endif -%}

      <div class="faq__list">
        {%- for block in section.blocks -%}
          <details class="accordion" {{ block.shopify_attributes }}>
            <summary class="accordion__summary">
              <span>{{ block.settings.question }}</span>
              {% render 'icon', name: 'chevron-down' %}
            </summary>
            <div class="rte accordion__content">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Everything about custom team gear, ordering, and timelines."
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How does custom team apparel work?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Add your answer here.</p>"
        }
      ]
    }
  ]
}
{% endschema %}
