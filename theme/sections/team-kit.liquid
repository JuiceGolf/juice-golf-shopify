{%- liquid
  assign featured_product = section.settings.product
-%}

<section class="section team-kit {% if section.settings.layout == 'image-right' %}team-kit--reverse{% endif %}" data-section-id="{{ section.id }}">
  <div class="page-width team-kit__grid">
    <div class="team-kit__media">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1400 }}"
          srcset="{{ section.settings.image | image_url: width: 700 }} 700w, {{ section.settings.image | image_url: width: 1400 }} 1400w"
          sizes="(min-width: 750px) 50vw, 100vw"
          alt="{{ section.settings.image.alt | default: featured_product.title | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        >
      {%- elsif featured_product != blank and featured_product.featured_image -%}
        <img
          src="{{ featured_product.featured_image | image_url: width: 1400 }}"
          srcset="{{ featured_product.featured_image | image_url: width: 700 }} 700w, {{ featured_product.featured_image | image_url: width: 1400 }} 1400w"
          sizes="(min-width: 750px) 50vw, 100vw"
          alt="{{ featured_product.featured_image.alt | default: featured_product.title | escape }}"
          width="{{ featured_product.featured_image.width }}"
          height="{{ featured_product.featured_image.height }}"
          loading="lazy"
        >
      {%- else -%}
        <img src="{{ 'team-kit-course.jpg' | asset_url }}" alt="{{ featured_product.title | default: section.settings.heading | escape }}" loading="lazy">
        {%- if request.design_mode -%}
          <span class="team-kit__stock-note">Stock photo &mdash; add real product/team photography above</span>
        {%- endif -%}
      {%- endif -%}
    </div>

    <div class="team-kit__content">
      <span class="eyebrow eyebrow--rule">{{ section.settings.eyebrow }}</span>
      <h2 class="h1">{{ section.settings.heading | default: featured_product.title }}</h2>

      {%- if section.settings.description != blank -%}
        <div class="rte text-muted">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="feature-tags">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if featured_product != blank -%}
        <div class="team-kit__meta">
          {% render 'price', product: featured_product %}
        </div>
      {%- endif -%}

      <div class="team-kit__actions">
        <a
          href="{{ section.settings.button_link | default: featured_product.url | default: '#' }}"
          class="button button--primary"
        >
          {{ section.settings.button_label }}
        </a>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .team-kit__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 1.5rem + 2vw, 4rem);
    align-items: center;
  }

  .team-kit--reverse .team-kit__grid {
    direction: rtl;
  }

  .team-kit--reverse .team-kit__content,
  .team-kit--reverse .team-kit__media {
    direction: ltr;
  }

  @media screen and (max-width: 749px) {
    .team-kit__grid {
      grid-template-columns: 1fr;
    }

    .team-kit--reverse .team-kit__grid {
      direction: ltr;
    }
  }

  .team-kit__media {
    overflow: hidden;
    background: var(--color-background-alt);
  }

  .team-kit__media {
    position: relative;
  }

  .team-kit__media img,
  .team-kit__media .media-placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 600ms ease;
  }

  .team-kit__media:hover img {
    transform: scale(1.035);
  }

  .team-kit__stock-note {
    position: absolute;
    z-index: 1;
    top: 0.75rem;
    right: 0.75rem;
    padding: 0.2em 0.6em;
    background: color-mix(in srgb, var(--color-dark-background) 80%, transparent);
    color: var(--color-dark-text);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .team-kit__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .team-kit__meta {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .team-kit__actions {
    margin-top: 0.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Team kit",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Select your flagship customizable jersey or team-kit product."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image override",
      "info": "Optional — uses the product's featured image if left empty."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "image-left", "label": "Image left" },
        { "value": "image-right", "label": "Image right" }
      ],
      "default": "image-left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Build Your Team Kit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override",
      "info": "Optional — uses the product title if left empty.",
      "default": "One Look. Every Player."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Choose your team colors, add every player's name and number, and outfit the whole group in one shared kit — jerseys, polos, hats, and the accessories that make it feel official.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Build Your Team"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link override"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Moisture-wicking performance fabric"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Team kit",
      "blocks": [
        { "type": "feature", "settings": { "text": "Team colors & custom logo" } },
        { "type": "feature", "settings": { "text": "Every player's name & number included" } },
        { "type": "feature", "settings": { "text": "Sized for the whole roster" } }
      ]
    }
  ]
}
{% endschema %}
