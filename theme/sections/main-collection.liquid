<section class="section collection" data-section-id="{{ section.id }}">
  <div class="page-width">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span>/</span>
      <span>{{ collection.title }}</span>
    </nav>

    <div class="collection__header">
      <h1 class="h1">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="rte text-muted collection__description">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products.size == 0 -%}
        <p class="text-muted">{{ 'collections.general.no_products' | t }}</p>
      {%- else -%}
        <div class="collection__grid grid grid--4">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="pagination__link" aria-label="Previous page">{% render 'icon', name: 'chevron-right', class: 'icon--flip' %}</a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="pagination__link">{{ part.title }}</a>
              {%- else -%}
                <span class="pagination__link" aria-current="page">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="pagination__link" aria-label="Next page">{% render 'icon', name: 'chevron-right' %}</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection pages",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16
    }
  ]
}
{% endschema %}
